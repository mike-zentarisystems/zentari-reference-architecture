# Copy to .env and populate with real values from the approved secret store.
# Never commit real credentials.

POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME

N8N_VERSION=PIN_ME
N8N_HOST=n8n.example.com
N8N_DB=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=CHANGE_ME
N8N_ENCRYPTION_KEY=CHANGE_ME

LITELLM_VERSION=PIN_ME
LITELLM_MASTER_KEY=CHANGE_ME
LITELLM_DATABASE_URL=postgresql://litellm:CHANGE_ME@postgres:5432/litellm

TWENTY_VERSION=PIN_ME
TWENTY_HOST=crm.example.com
TWENTY_DATABASE_URL=postgresql://twenty:CHANGE_ME@postgres:5432/twenty
TWENTY_APP_SECRET=CHANGE_ME
