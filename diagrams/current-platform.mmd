flowchart TB
    USERS["Users / Customers"]
    CF["Cloudflare\nDNS / WAF / Edge"]
    VERCEL["Vercel\nPublic web apps / portals"]

    USERS --> CF
    CF --> VERCEL

    subgraph ATLAS["ATLAS — Production VPS"]
        CADDY["Caddy\nIngress / TLS"]
        TWENTY["Twenty CRM"]
        N8N["n8n\nZentari internal automation"]
        PG[("PostgreSQL")]
        LITELLM["LiteLLM\nProduction AI gateway"]
        APPFLOWY["AppFlowy\nOptional company knowledge"]
        PRODAPPS["Production app services"]

        CADDY --> TWENTY
        CADDY --> N8N
        CADDY --> APPFLOWY
        CADDY --> PRODAPPS
        TWENTY --> PG
        N8N --> PG
        LITELLM --> PG
    end

    VERCEL --> CADDY

    subgraph CITADEL["CITADEL — Zentari AI Appliance"]
        HERMES1["Hermes Primary"]
        OLLAMA["Ollama / llama.cpp\nRTX 3060 12 GB"]
        QDRANT[("Qdrant\nRebuildable index")]
        EMB["Embeddings / Reranking"]
        AITOOLS["AI-specific tools"]

        HERMES1 --> OLLAMA
        HERMES1 --> QDRANT
        EMB --> QDRANT
        HERMES1 --> AITOOLS
    end

    LITELLM --> OLLAMA

    subgraph FORGE["FORGE — Primary Proxmox"]
        STAGING["Production-like Staging"]
        COOLIFY["Coolify Control VM\nOptional convenience"]
        OBS["Basic Observability VM"]
        BUZZ["Buzz / AI Dev VM"]
        LAB["Disposable Lab\nOnly when needed"]
    end

    subgraph VAULT["VAULT — R410 / Second Proxmox"]
        PBS["Proxmox Backup Server"]
        RESTICLOCAL["Local Backup / Restic Repository"]
        RESTORE["Restore-Test Workspace"]
        ARCHIVE["ISO / Templates / Bulk Archive"]
    end

    subgraph ORACLE["ORACLE OCI — External Watchtower"]
        HERMES2["Hermes Secondary\nOptional degraded mode"]
        KUMA["Uptime Kuma"]
        CHECKS["External DNS / SSL / Backup Checks"]
    end

    B2["Backblaze B2\nOffsite Recovery"]
    TS["Tailscale\nPrivate management fabric"]

    ATLAS -. private management .-> TS
    CITADEL -. private management .-> TS
    FORGE -. private management .-> TS
    VAULT -. private management .-> TS
    ORACLE -. private management .-> TS

    FORGE --> PBS
    ATLAS --> RESTICLOCAL
    CITADEL --> RESTICLOCAL
    PBS --> B2
    RESTICLOCAL --> B2

    ORACLE -. external monitoring .-> ATLAS
    ORACLE -. external monitoring .-> CITADEL
    ORACLE -. external monitoring .-> FORGE
    ORACLE -. external monitoring .-> VAULT

    STAGING -. validate before production .-> ATLAS
    COOLIFY -. deploy/manage where useful .-> ATLAS
    COOLIFY -. deploy/manage where useful .-> STAGING

    HERMES2 -. cloud fallback / degraded mode .-> LITELLM

